# Shippo Tool Configuration

# Default sender address (saves typing for repeated shipments)
default_sender:
  name: "Your Company Name"
  street1: "123 Main St"
  street2: ""
  city: "Your City"
  state: "CA"
  zip: "90001"
  country: "US"
  phone: "+11234567890"
  email: "you@example.com"

# User preferences
preferences:
  # Automatically select cheapest rate
  auto_select_cheapest: false

  # Label format: PDF, PNG, or ZPL (thermal printer)
  label_format: "PDF"

  # Preferred carrier (optional): usps, ups, fedex
  default_carrier: null
