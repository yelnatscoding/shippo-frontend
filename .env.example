# EasyPost API Configuration
# Get your API key from: https://www.easypost.com/account/api-keys
EASYPOST_API_KEY=EZTEST_your_test_key_here
EASYPOST_TEST_MODE=true

# Shippo API Configuration
# Get your API key from: https://goshippo.com/user/apikeys
SHIPPO_API_KEY=shippo_test_your_key_here
SHIPPO_TEST_MODE=true

# ShipEngine API Configuration
# Get your API key from: https://app.shipengine.com/#/portal/apimanagement
SHIPENGINE_API_KEY=TEST_your_key_here

# Easyship API Configuration
# Get your API key from: https://app.easyship.com/settings/api
EASYSHIP_API_KEY=your_easyship_key_here
