# EasyPost API Configuration
# Get your API key from: https://www.easypost.com/account/api-keys

# Test mode (use test API key for development)
EASYPOST_API_KEY=EZTEST_your_test_key_here

# Production mode (use live API key)
# EASYPOST_API_KEY=EZAK_your_live_key_here

# Set to 'true' for test mode, 'false' for production
EASYPOST_TEST_MODE=true
